rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:@]+$');
    }

    function isOwner(userId) {
      return userId is string && (
        userId == request.auth.uid || 
        (request.auth.token != null && request.auth.token.email != null && userId.lower() == request.auth.token.email.lower())
      );
    }

    function isValidDocument(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.rows is list && data.rows.size() <= 5000 &&
             data.headers is list && data.headers.size() <= 50;
    }

    function isValidSettings(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (data.blueText == null || (data.blueText is string && data.blueText.size() <= 100000)) &&
             (data.secretList == null || (data.secretList is list && data.secretList.size() <= 1000)) &&
             (data.pin == null || (data.pin is string && data.pin.size() <= 100)) &&
             (data.gistToken == null || (data.gistToken is string && data.gistToken.size() <= 200)) &&
             (data.gistId == null || (data.gistId is string && data.gistId.size() <= 200)) &&
             (data.geminiKey == null || (data.geminiKey is string && data.geminiKey.size() <= 200));
    }

    // Documents match block
    match /documents/{documentId} {
      allow get: if isSignedIn() && (resource == null || isOwner(resource.data.userId) || documentId == 'test');
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || 
                    (request.auth.token != null && request.auth.token.email != null && resource.data.userId == request.auth.token.email));
      
      allow create: if isSignedIn() && 
                       isValidId(documentId) && 
                       isValidDocument(request.resource.data) && 
                       isOwner(request.resource.data.userId);
                       
      allow update: if isSignedIn() && 
                       isValidId(documentId) && 
                       isValidDocument(request.resource.data) && 
                       isOwner(resource.data.userId) && 
                       isOwner(request.resource.data.userId);
                       
      allow delete: if isSignedIn() && 
                       isValidId(documentId) &&
                       (resource == null || isOwner(resource.data.userId));
    }

    function isValidMediaChunk(data) {
      return data.keys().hasAll(['id', 'docId', 'userId', 'rowId', 'kind', 'chunkIndex', 'totalChunks', 'data']) &&
             data.id is string && data.id.size() <= 128 &&
             data.docId is string && data.docId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.rowId is string && data.rowId.size() <= 128 &&
             data.kind in ['image', 'audio'] &&
             data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex < 150 &&
             data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 150 &&
             data.data is string && data.data.size() <= 600000;
    }

    // Settings match block
    match /settings/{settingsId} {
      allow get: if isSignedIn() && (isOwner(settingsId) || (resource != null && isOwner(resource.data.userId)));
      
      allow create, update: if isSignedIn() && 
                               isValidId(settingsId) && 
                               isValidSettings(request.resource.data) && 
                               isOwner(request.resource.data.userId) &&
                               isOwner(settingsId);
                               
      allow delete: if isSignedIn() && 
                       (isOwner(settingsId) || (resource != null && isOwner(resource.data.userId)));
    }

    // Chunked media (images & audio) match block
    match /media_chunks/{chunkId} {
      allow get: if isSignedIn() && (resource == null || isOwner(resource.data.userId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid ||
                    (request.auth.token != null && request.auth.token.email != null && resource.data.userId == request.auth.token.email));

      allow create: if isSignedIn() &&
                       isValidId(chunkId) &&
                       isValidMediaChunk(request.resource.data) &&
                       isOwner(request.resource.data.userId);

      allow update: if isSignedIn() &&
                       isValidId(chunkId) &&
                       isValidMediaChunk(request.resource.data) &&
                       isOwner(resource.data.userId) &&
                       isOwner(request.resource.data.userId);

      allow delete: if isSignedIn() &&
                       isValidId(chunkId) &&
                       (resource == null || isOwner(resource.data.userId));
    }
  }
}
